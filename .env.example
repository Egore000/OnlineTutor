PYTHONPATH=src/app/
PROJECTNAME=tutor

APP_NAME="TutorOnline"
APP_DESCRIPTION="API for Tutor Management System"
APP_VERSION="0.0.1"
APP_DEBUG=True

DB_ENGINE=postgresql
DB_DRIVER=asyncpg
DB_NAME=db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=db

SERVER_HOST="0.0.0.0"
SERVER_PORT=8000

JWT_SECRET_KEY=secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
